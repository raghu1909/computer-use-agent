# Only needed for real LLM discovery (--llm anthropic). Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Values for `sensitive` capability parameters; injected at invocation, never persisted.
# These are the fictional demo credentials of the local mock target app.
CAP_SECRET_operator_user=operator
CAP_SECRET_operator_password=letmein-demo

TARGET_URL=http://localhost:5000
